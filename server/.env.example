# 이 파일을 복사해서 .env를 만들고 값을 채운다:  cp .env.example .env
# .env는 절대 커밋하지 않는다 (.gitignore에 포함). 키를 채팅·노션에 붙여 넣지 말 것.

ENVIRONMENT=development

# DB: 기본은 로컬 SQLite 파일.
# Supabase를 쓰면 대시보드 상단 [Connect] > Session pooler의 연결 문자열을 그대로 붙여 넣는다
# ([YOUR-PASSWORD] 부분만 DB 비밀번호로 교체). postgresql:// 로 시작해도 서버가 알아서 처리한다.
#   예) postgresql://postgres.<project-ref>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# 비밀번호에 @ : / # 같은 특수문자가 있으면 URL 인코딩이 필요하니 영문·숫자로만 정하는 것을 추천
DATABASE_URL=sqlite:///./dev.db
# true면 서버 시작 시 없는 테이블을 자동 생성 (개발용)
AUTO_CREATE_TABLES=true

# 프론트엔드 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:3000

# --- 인증 (Supabase Auth) ---
# Supabase 프로젝트 URL. 설정하면 발급자(iss) 검증과 RS256/ES256 키 조회에 쓰인다
SUPABASE_URL=
# HS256 서명 키. Supabase: Project Settings > API > JWT Secret (Legacy)
# Supabase 연동 전에는 아무 32자 이상 문자열로 두고 scripts/make_dev_token.py로 토큰을 만든다
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
JWT_AUDIENCE=authenticated
# 회원 탈퇴 시 Supabase 로그인 계정까지 지우려면 필요 (서버 전용, 프론트에 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 사용자 UUID (쉼표로 여러 개). 토큰의 app_metadata.role=admin도 관리자로 인정
ADMIN_USER_IDS=

# false면 공지 목록·상세도 로그인한 사용자만 볼 수 있음
NOTICES_PUBLIC=true
# 검색·열람 기록 보관 일수
ACTIVITY_RETENTION_DAYS=90
