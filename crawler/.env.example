# crawler/에서 실행. server/ 기본 DB 파일과 같은 파일을 가리킨다.
DATABASE_URL=sqlite:///../server/dev.db
API_BASE_URL=http://127.0.0.1:8000/api/v1
# 관리자 토큰. README의 PowerShell 실습에서는 현재 창의 환경변수로 설정한다.
ADMIN_ACCESS_TOKEN=
# 운영: server 담당자가 전달한 crawler 전용 session pooler(5432) 또는 direct 연결
# DATABASE_URL=postgresql://crawler.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CRAWLER_USER_AGENT=GonsadajobCrawler/1.0
HTTP_TIMEOUT_SECONDS=30
REQUEST_INTERVAL_SECONDS=3
PAGES_PER_BOARD=2
NOTICES_PER_BOARD=40
ANALYSES_PER_CYCLE=10
POLL_SECONDS=60
